        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Architektura systemu obsługi kina\n\nskinparam componentStyle rectangle\n\nactor \&quot;Klient\&quot; as Klient\nactor \&quot;Pracownik kina\&quot; as Pracownik\nactor \&quot;Administrator\&quot; as Admin\n\nnode \&quot;System obsługi kina\&quot; {\n\n    package \&quot;Warstwa prezentacji\&quot; {\n        component \&quot;Frontend\\nReact\&quot; as Frontend\n    }\n\n    package \&quot;Warstwa logiki biznesowej\&quot; {\n        component \&quot;Backend\\nSpring Boot\&quot; as Backend\n\n        component \&quot;Moduł użytkowników\&quot; as Users\n        component \&quot;Moduł filmów\&quot; as Movies\n        component \&quot;Moduł seansów\&quot; as Screenings\n        component \&quot;Moduł rezerwacji\&quot; as Reservations\n        component \&quot;Moduł biletów\&quot; as Tickets\n        component \&quot;Moduł płatności\&quot; as Payments\n    }\n\n    package \&quot;Warstwa danych\&quot; {\n        database \&quot;PostgreSQL\&quot; as DB\n    }\n}\n\ncloud \&quot;System płatności\&quot; as PaymentSystem\ncloud \&quot;Usługa e-mail\&quot; as EmailService\n\nKlient --&gt; Frontend\nPracownik --&gt; Frontend\nAdmin --&gt; Frontend\n\nFrontend --&gt; Backend\n\nBackend --&gt; Users\nBackend --&gt; Movies\nBackend --&gt; Screenings\nBackend --&gt; Reservations\nBackend --&gt; Tickets\nBackend --&gt; Payments\n\nUsers --&gt; DB\nMovies --&gt; DB\nScreenings --&gt; DB\nReservations --&gt; DB\nTickets --&gt; DB\n\nPayments --&gt; PaymentSystem\nBackend --&gt; EmailService\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LR78__6kHI4_xrvfIK23-289">
